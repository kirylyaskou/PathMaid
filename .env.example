# Cloud sync (Supabase).
# Copy this file to `.env` and fill in values from your Supabase project:
#   Project Settings → API → Project URL + anon public key.
# Both vars are safe to bundle into the client — the anon key is public by design
# and access is enforced server-side via Row Level Security (RLS).
# Leave commented/unset to disable cloud sync entirely; the app stays local-first.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
